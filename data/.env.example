# Atom environment configuration
#
# setup_atom.py copies this file to .env during setup. Fill in what you need.
# .env is gitignored: never commit it, and never paste a key into an issue.

# Gemini API key(s). All of them are used round-robin.
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=

# Optional: Brave Search API key, if you want better web results.
# Without it Atom uses DuckDuckGo, then Wikipedia.
# BRAVE_SEARCH_API_KEY=

# Optional: Tesseract binary, when it is not on PATH.
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# The Gemini model, Ollama URL and the rest of the settings live in
# data/config.json — edit them from Settings (the gear in the chat panel).
